# AWS region
AWS_DEFAULT_REGION=eu-south-1

# Lambda function name
FUNCTION_NAME=claude-youtube-transcript

# IAM role name for Lambda execution
LAMBDA_ROLE_NAME=claude-youtube-transcript-exec

# S3 bucket for Lambda deployment packages (auto-computed if empty: <FUNCTION_NAME>-deploy-<account-id>)
DEPLOY_BUCKET=

# Lambda memory in MB (default: 256)
LAMBDA_MEMORY=256

# OAuth token lifetimes. Claude renews the access token with the refresh token,
# so you only need to reconnect if the refresh token expires (or the OAuth secret changes).
# Access token TTL in hours (default: 720 = 30 days)
ACCESS_TOKEN_TTL_HOURS=
# Refresh token TTL in days (default: 365); a new one is issued on every renewal
REFRESH_TOKEN_TTL_DAYS=

# Webshare *Residential* proxy for youtube-transcript-api.
# Strongly recommended on AWS: YouTube blocks most cloud IPs, so without it
# transcript fetches usually fail (RequestBlocked / IpBlocked).
# Plan: "Residential" (rotating) — NOT "Proxy Server" or "Static Residential".
# Credentials: Webshare dashboard → Residential → Proxy Settings → Proxy Username / Password
# (these are NOT your Webshare account login).
# Keep them here: they are used only by bootstrap.sh / deploy.sh, which store them
# in the Secrets Manager secret <FUNCTION_NAME>-webshare (JSON {"username","password"})
# on every run. They are never passed to the Lambda. Set both or neither.
WEBSHARE_USERNAME=
WEBSHARE_PASSWORD=
